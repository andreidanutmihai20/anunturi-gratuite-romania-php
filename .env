# ============================================
# COPIAZA ACEST FISIER CA ".env" SI COMPLETEAZA
# ============================================

# MongoDB Atlas - connection string
# Atlas -> Clusters -> Connect -> Drivers -> PHP -> copiaza string-ul
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=olxclone

# JWT Secret - o parola lunga si aleatoare (min 32 caractere)
JWT_SECRET=schimba_cu_o_parola_secreta_lunga_de_minim_32_caractere

# URL-ul frontendului Firebase (fara slash la final)
FRONTEND_URL=https://your-project-id.web.app

# Cloudinary (pentru upload imagini - gratuit pe cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
